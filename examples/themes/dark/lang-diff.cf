local hl = require("cf.hl.setup")
local c = hl.colors
local l = hl.language

return l.setup("diff", {
	l:group("comment", { fg = c.comment, italic = true }),
	l:group("diff", {
		style_targets = { vim = false, ts = true, lsp = false },
		typemods = {
			["plus"] = { fg = c.green },
			["minus"] = { fg = c.red },
			["delta"] = { fg = c.yellow },
		},
	}),

})

local hl = require("cf.hl.setup")
local c = hl.colors
local p = hl.plugin

return p.setup("render-markdown", {
	style_targets = { vim = true, ts = false, lsp = false },
	p:group("RenderMarkdownH1", { fg = c.func, bold = true }),
	p:group("RenderMarkdownH2", { fg = c.type, bold = true }),
	p:group("RenderMarkdownH3", { fg = c.keyword, bold = true }),
	p:group("RenderMarkdownH4", { fg = c.fg, bold = true }),
	p:group("RenderMarkdownH5", { fg = c.fg, bold = true }),
	p:group("RenderMarkdownH6", { fg = c.comment, bold = true }),
	p:group("RenderMarkdownH1Bg", { bg = c.func, pipeline = { hl.opacity.bg(7) } }),
	p:group("RenderMarkdownH2Bg", { bg = c.type, pipeline = { hl.opacity.bg(6) } }),
	p:group("RenderMarkdownH3Bg", { bg = c.keyword, pipeline = { hl.opacity.bg(5) } }),
	p:group("RenderMarkdownH4Bg", { bg = c.fg, pipeline = { hl.opacity.bg(4) } }),
	p:group("RenderMarkdownH5Bg", { bg = c.fg, pipeline = { hl.opacity.bg(4) } }),
	p:group("RenderMarkdownH6Bg", { bg = c.comment, pipeline = { hl.opacity.bg(4) } }),
	p:group("RenderMarkdownCode", { bg = c.line_alt }),
	p:group("RenderMarkdownCodeInfo", { fg = c.cyan, bg = c.line_alt }),
	p:group("RenderMarkdownCodeBorder", { fg = c.border, bg = c.line_alt }),
	p:group("RenderMarkdownCodeFallback", { fg = c.comment, bg = c.line_alt }),
	p:group("RenderMarkdownCodeInline", { fg = c.string, bg = c.line_alt }),
	p:group("RenderMarkdownQuote", { fg = c.comment, italic = true, types = { "RenderMarkdownQuote1", "RenderMarkdownQuote2", "RenderMarkdownQuote3", "RenderMarkdownQuote4", "RenderMarkdownQuote5", "RenderMarkdownQuote6" } }),
	p:group("RenderMarkdownBullet", { fg = c.orange }),
	p:group("RenderMarkdownDash", { fg = c.muted }),
	p:group("RenderMarkdownSign", { link = "SignColumn" }),
	p:group("RenderMarkdownMath", { fg = c.magenta }),
	p:group("RenderMarkdownIndent", { fg = c.line_alt }),
	p:group("RenderMarkdownHtmlComment", { fg = c.comment, italic = true }),
	p:group("RenderMarkdownLink", { fg = c.blue, underline = true }),
	p:group("RenderMarkdownInlineHighlight", { link = "RenderMarkdownCodeInline" }),
})

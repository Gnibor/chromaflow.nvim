local hl = require("cf.hl.setup")
local c = hl.colors
local l = hl.language

return l.setup("vimdoc", {
	l:group("comment", { fg = c.comment, italic = true }),
	l:group("string", { fg = c.string }),
	l:group("keyword", { fg = c.keyword }),
	l:group("markup", {
		style_targets = { vim = false, ts = true, lsp = false },
		typemods = {
			["heading"] = { fg = c.orange, bold = true },
			["link"] = { fg = c.blue, underline = true },
			["link.label"] = { fg = c.cyan },
			["raw"] = { fg = c.string },
		},
	}),

	l:group("label", { style_targets = { vim = false, ts = true, lsp = false }, fg = c.magenta }),
	l:group("string", {
		style_targets = { vim = false, ts = true, lsp = false },
		typemods = {
			["special"] = { fg = c.cyan },
		},
	}),
})

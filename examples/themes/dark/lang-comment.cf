local hl = require("cf.hl.setup")
local c = hl.colors
local l = hl.language

return l.setup("comment", {
	l:group("comment", { fg = c.comment, italic = true }),
	l:group("comment", {
		style_targets = { vim = false, ts = true, lsp = false },
		typemods = {
			["todo"] = { fg = c.black, bg = c.yellow, bold = true },
			["note"] = { fg = c.blue, bold = true },
			["warning"] = { fg = c.yellow, bold = true },
			["error"] = { fg = c.red, bold = true },
		},
	}),

})

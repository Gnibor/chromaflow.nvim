local hl = require("cf.hl.setup")
local c = hl.colors
local p = hl.plugin

return p.setup("codemap", {
	style_targets = { ts = true },
	-- TypeMod-owned TS styles: CodeMap/MyMarker need no base highlight.
	p:group("CodeMap", {
		typemods = {
			keyword = { fg = c.keyword, bold = true, },
			entry = { fg = c.comment },
			["function"] = { fg = c.func, bold = true },
			status = { fg = c.cyan, bold = true },
			role = { fg = c.magenta },
			responsibility = { fg = c.orange },
			why = { fg = c.comment, italic = true }
		}
	}),

	-- MyMarker adds arbitrary keyword-specific captures at runtime, but every
	-- generated query also exposes these two stable base captures.
	p:group("MyMarker", {
		typemods = {
			keyword = { fg = c.keyword, bold = true },
			entry = { fg = c.comment }
		}
	}),
})

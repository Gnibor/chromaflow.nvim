	u:group("TabLine", { fg = c.muted, bg = c.line }),
	u:group("TabLineFill", { bg = c.bg }),
	u:group("TabLineSel", { fg = c.fg, bg = c.selection_soft, bold = true }),

	u:group("Pmenu", { fg = c.fg, bg = c.line }),
	u:group("PmenuSel", { fg = c.fg, bg = c.selection, bold = true }),
	u:group("PmenuSbar", { bg = c.line_alt }),

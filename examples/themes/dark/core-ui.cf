		pipeline = { hl.opacity.fg(60) },
	}),

	u:group("LspReferenceText", {
		bg = c.blue,
		pipeline = { hl.opacity.bg(10) },
	}),
	u:group("LspReferenceRead", {
		bg = c.green,
		pipeline = { hl.opacity.bg(10) },

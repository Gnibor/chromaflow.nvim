	u:group("SpecialKey", { fg = c.muted }),
	u:group("EndOfBuffer", { fg = c.bg }),
	u:group("Conceal", { fg = c.comment }),

	u:group("SpellBad", { sp = c.red, undercurl = true }),
	u:group("SpellCap", { sp = c.blue, undercurl = true }),
	u:group("SpellRare", { sp = c.magenta, undercurl = true }),
	u:group("SpellLocal", { sp = c.cyan, undercurl = true }),

	u:group("DiagnosticError", { fg = c.red }),

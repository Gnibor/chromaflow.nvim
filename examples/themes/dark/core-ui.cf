	u:group("Visual", { bg = c.selection }),
	u:group("VisualNOS", { bg = c.selection_soft }),
	u:group("MatchParen", { fg = c.yellow, bg = c.selection_soft, bold = true }),

	u:group("LineNr", { fg = c.muted, bg = c.bg }),

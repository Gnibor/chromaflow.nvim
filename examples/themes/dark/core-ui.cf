local hl = require("cf.hl.setup")
local c = hl.colors
local u = hl.ui

return u.setup({
	u:group("Normal", { fg = c.fg, bg = c.bg }),
	u:group("NormalNC", { link = "Normal" }),
	u:group("NormalFloat", { fg = c.fg, bg = c.line }),
	u:group("FloatBorder", { fg = c.border, bg = c.line }),
	u:group("FloatTitle", { fg = c.orange, bg = c.line, bold = true }),

	u:group("CursorLine", { bg = c.line }),

	u:group("Search", { fg = c.black, bg = c.yellow }),
	u:group("IncSearch", { fg = c.black, bg = c.orange, bold = true }),
	u:group("CurSearch", { link = "IncSearch" }),
	u:group("Substitute", { fg = c.black, bg = c.magenta }),
	u:group("QuickFixLine", { bg = c.selection_soft }),

	u:group("Directory", { fg = c.blue }),
	u:group("Title", { fg = c.orange, bold = true }),
	u:group("Question", { fg = c.green }),
	u:group("MoreMsg", { fg = c.green }),

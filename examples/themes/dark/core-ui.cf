	u:group("LspSignatureActiveParameter", { fg = c.orange, bold = true }),

	u:group("DiffAdd", {
		fg = c.green, bg = c.green,
		pipeline = { hl.opacity.bg(10) },
	}),
	u:group("DiffChange", {
		fg = c.yellow, bg = c.yellow,

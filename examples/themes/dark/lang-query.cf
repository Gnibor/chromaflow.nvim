local hl = require("cf.hl.setup")
local c = hl.colors
local l = hl.language

return l.setup("query", {
	l:group("comment", { fg = c.comment, italic = true }),
	l:group("string", { fg = c.string }),
	l:group("variable", { fg = c.variable }),
	l:group("property", { fg = c.property }),
	l:group("operator", { fg = c.operator }),
	l:group("variable", {
		style_targets = { vim = false, ts = true, lsp = false },
		typemods = {
			["member"] = { fg = c.property },
		},
	}),
	l:group("constructor", { style_targets = { vim = false, ts = true, lsp = false }, fg = c.type }),
	l:group("punctuation", {
		style_targets = { vim = false, ts = true, lsp = false },
		typemods = {
			["bracket"] = { fg = c.muted },
			["delimiter"] = { fg = c.muted },
		},
	}),

})
